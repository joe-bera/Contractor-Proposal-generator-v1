AWS_S3_BUCKET="contractor-proposals"

# Clerk (Authentication)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""

# Stripe (Payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
